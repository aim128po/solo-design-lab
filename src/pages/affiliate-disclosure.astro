---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Affiliate Disclosure | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>
			<h1>Affiliate Disclosure</h1>

			<p>
				Solo Design Lab may use affiliate links in some articles and recommendations.
			</p>

			<p>
				This means we may earn a commission if you purchase a product or service
				through one of our links, at no additional cost to you.
			</p>

			<p>
				Our recommendations are based on research, product information,
				and hands-on evaluation whenever possible.
			</p>

			<p>
				Affiliate relationships do not determine which products we feature
				or how we evaluate them.
			</p>
		</main>

		<Footer />
	</body>
</html>