---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Privacy Policy | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>
			<h1>Privacy Policy</h1>

			<p>
				Solo Design Lab respects your privacy and is committed to protecting
				the personal information of visitors to this website.
			</p>

			<h2>Information We Collect</h2>
			<p>
				We may collect limited information when you visit this website,
				such as browser type, device information, referring pages, and
				general usage data through analytics tools.
			</p>

			<h2>Cookies</h2>
			<p>
				This website may use cookies or similar technologies to improve
				website performance, understand visitor behavior, and support
				affiliate tracking.
			</p>

			<h2>Affiliate Links</h2>
			<p>
				Some pages on Solo Design Lab may contain affiliate links.
				If you click one of these links and make a purchase, we may earn
				a commission at no additional cost to you.
			</p>

			<h2>Third-Party Services</h2>
			<p>
				We may use third-party services for website hosting, analytics,
				affiliate tracking, and other website functions. These third parties
				may collect information according to their own privacy policies.
			</p>

			<h2>Contact</h2>
			<p>
				If you have any questions about this Privacy Policy,
				please contact us through the Contact page.
			</p>

			<p>
				Last updated: September 2026
			</p>
		</main>

		<Footer />
	</body>
</html>
