---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
	<meta name="impact-site-verification" value="6779e3db-a6e2-49e0-827a-57afa5076dac">
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<p>Design smarter. Create better.</p>
				<h1>Solo Design Lab</h1>
				<p>
					Discover practical design tools, templates, and creative resources
					to help you create better content, build a stronger brand, and work more efficiently.
				</p>

				<p>
					<a href="/blog/">Explore the latest guides →</a>
				</p>
			</section>

			<section>
				<h2>What you'll find here</h2>

				<h3>Design Tools</h3>
				<p>
					Compare useful design platforms for graphics, presentations,
					social media content, and more.
				</p>

				<h3>Templates</h3>
				<p>
					Find templates and creative resources that make creating polished
					content faster and easier.
				</p>

				<h3>Branding</h3>
				<p>
					Discover tools and resources for building a consistent,
					professional-looking brand.
				</p>

				<h3>AI Design</h3>
				<p>
					Explore AI-powered tools for creating and editing visual content.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>